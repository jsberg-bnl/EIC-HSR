call, file='../../hsr.bmad'

parameter[particle] = antiproton

ep = (45.5/anomalous_moment_of(proton))*m_proton
pp = sqrt(ep^2-m_proton^2)
emx = 2.5e-6*m_proton/pp
emy = 2.5e-6*m_proton/pp
dp = 7.4e-4
nsx = 8
nsy = 7

beginning[e_tot] = ep

ov_b0pf[dgint] = -1.69767029190806139E-03

call, file='rhic.bmad'
call, file='ir2.bmad'
call, file='ir4.bmad'
call, file='ir6.bmad'
call, file='ir8.bmad'
call, file='ir10.bmad'
call, file='ir12.bmad'

use, hsr_hi_8s_2s
